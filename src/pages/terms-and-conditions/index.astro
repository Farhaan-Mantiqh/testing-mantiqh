---
import MainLayout from "../../layouts/MainLayout.astro";
import Navbar from "../../components/layout/Navbar.astro";
---

<MainLayout
  title="Terms & Conditions | Mantiqh"
  description="Terms & Conditions for Mantiqh Technologies."
  canonicalURL="https://mantiqh.com/terms-and-conditions"
>
  <div class="bg-white text-slate-800 font-sans min-h-screen">
    <div class="bg-white flex flex-col flex-grow max-w-[1440px] mx-auto w-full border-x border-slate-200/20 relative">
      <Navbar theme="light" />

      <main class="max-w-4xl mx-auto w-full px-6 py-12 md:py-16 space-y-10">
        <header class="pb-4 space-y-4">
          <h1 class="text-4xl md:text-5xl font-bold text-slate-900 tracking-tight">
            Terms & Conditions
          </h1>
          <p class="text-slate-600 text-base leading-relaxed">
            Welcome to Mantiqh. These Terms & Conditions ("Terms") govern your access to and use of the Mantiqh website, products, services, digital platforms, and related content.
          </p>
          <p class="text-slate-600 text-base leading-relaxed">
            By accessing or using our website, you agree to comply with these Terms. If you do not agree with any part of these Terms, please discontinue use of the website.
          </p>
        </header>

        <div class="space-y-10 text-slate-700 leading-relaxed text-base">
          {/* About Mantiqh */}
          <section class="space-y-3">
            <h2 class="text-2xl md:text-3xl font-semibold text-slate-900">
              About Mantiqh
            </h2>
            <p>
              Throughout these Terms, the terms "Mantiqh", "we", "our", and "us" refer to Mantiqh and its affiliated entities.
            </p>
            <p>
              The term "you" refers to any visitor, client, user, business partner, or organization accessing this website.
            </p>
          </section>

          {/* Website Usage */}
          <section class="space-y-4">
            <h2 class="text-2xl md:text-3xl font-semibold text-slate-900">
              Website Usage
            </h2>
            <p>
              You agree to use this website only for lawful purposes and in a manner that does not infringe upon the rights of others or restrict their use of the website.
            </p>
            <div class="space-y-2">
              <p class="font-medium text-slate-900">You must not:</p>
              <ul class="list-disc list-inside space-y-1 text-slate-700 pl-4">
                <li>Attempt unauthorized access to our systems or networks.</li>
                <li>Upload malicious software, viruses, or harmful code.</li>
                <li>Interfere with the website's functionality or security.</li>
                <li>Misrepresent your identity or business information.</li>
                <li>Use the website for fraudulent, unlawful, or abusive activities.</li>
              </ul>
            </div>
            <p>
              We reserve the right to suspend or restrict access if these Terms are violated.
            </p>
          </section>

          {/* Professional Services */}
          <section class="space-y-4">
            <h2 class="text-2xl md:text-3xl font-semibold text-slate-900">
              Professional Services
            </h2>
            <p>
              Mantiqh provides enterprise technology services including, but not limited to:
            </p>
            <ul class="list-disc list-inside space-y-1 text-slate-700 pl-4">
              <li>Artificial Intelligence Solutions</li>
              <li>Product Development</li>
              <li>Product Design</li>
              <li>Enterprise Content Management</li>
              <li>Data & Analytics</li>
              <li>Cloud Solutions</li>
              <li>Managed Support Services</li>
              <li>Testing & Quality Assurance</li>
              <li>Technology Consulting</li>
              <li>Digital Transformation Services</li>
            </ul>
            <p>
              Information presented on this website is for general business information only.
            </p>
            <p>
              Any consulting, software development, implementation, or technology engagement shall be governed separately through mutually agreed proposals, Statements of Work (SOWs), Master Service Agreements (MSAs), Non-Disclosure Agreements (NDAs), or other contractual documents.
            </p>
          </section>

          {/* Intellectual Property */}
          <section class="space-y-4">
            <h2 class="text-2xl md:text-3xl font-semibold text-slate-900">
              Intellectual Property
            </h2>
            <p>
              Unless otherwise stated, all content available on this website, including but not limited to:
            </p>
            <ul class="list-disc list-inside space-y-1 text-slate-700 pl-4">
              <li>Logos</li>
              <li>Brand Identity</li>
              <li>Graphics</li>
              <li>Illustrations</li>
              <li>Icons</li>
              <li>User Interface Designs</li>
              <li>Website Layouts</li>
              <li>Source Content</li>
              <li>Images</li>
              <li>Videos</li>
              <li>Case Studies</li>
              <li>Documents</li>
              <li>Product Concepts</li>
              <li>Software Assets</li>
            </ul>
            <p>
              is owned by or licensed to Mantiqh and protected under applicable intellectual property laws.
            </p>
            <p>
              No material may be copied, reproduced, modified, distributed, republished, or commercially exploited without prior written consent from Mantiqh.
            </p>
          </section>

          {/* User Submissions */}
          <section class="space-y-4">
            <h2 class="text-2xl md:text-3xl font-semibold text-slate-900">
              User Submissions
            </h2>
            <p>
              Information submitted through contact forms, consultation requests, career applications, or other communication channels must be accurate and lawful.
            </p>
            <div class="space-y-2">
              <p class="font-medium text-slate-900">By submitting information to Mantiqh, you confirm that:</p>
              <ul class="list-disc list-inside space-y-1 text-slate-700 pl-4">
                <li>The information provided is accurate.</li>
                <li>You have the authority to share such information.</li>
                <li>Your submission does not violate the rights of any third party.</li>
              </ul>
            </div>
          </section>

          {/* Confidentiality */}
          <section class="space-y-4">
            <h2 class="text-2xl md:text-3xl font-semibold text-slate-900">
              Confidentiality
            </h2>
            <p>
              Business discussions initiated through this website are treated professionally and with reasonable confidentiality.
            </p>
            <p>
              Formal confidentiality obligations become legally binding only after execution of an appropriate confidentiality agreement such as a Non-Disclosure Agreement (NDA).
            </p>
          </section>

          {/* Third-Party Websites */}
          <section class="space-y-4">
            <h2 class="text-2xl md:text-3xl font-semibold text-slate-900">
              Third-Party Websites
            </h2>
            <p>
              Our website may include links to third-party websites, platforms, or resources.
            </p>
            <p>
              These links are provided solely for user convenience.
            </p>
            <p>
              Mantiqh does not control, endorse, or assume responsibility for the content, privacy practices, availability, or accuracy of external websites.
            </p>
            <p>
              Users access third-party websites at their own discretion.
            </p>
          </section>

          {/* Disclaimer */}
          <section class="space-y-4">
            <h2 class="text-2xl md:text-3xl font-semibold text-slate-900">
              Disclaimer
            </h2>
            <p>
              The information available on this website is provided for general informational purposes only.
            </p>
            <p>
              While Mantiqh makes reasonable efforts to ensure that website content remains accurate and up to date, we make no warranties or representations regarding:
            </p>
            <ul class="list-disc list-inside space-y-1 text-slate-700 pl-4">
              <li>Accuracy</li>
              <li>Completeness</li>
              <li>Reliability</li>
              <li>Availability</li>
              <li>Timeliness</li>
              <li>Suitability</li>
            </ul>
            <p>
              of any information, content, services, or materials presented on this website.
            </p>
            <p>
              Any reliance placed on website information is strictly at your own risk.
            </p>
          </section>

          {/* Limitation of Liability */}
          <section class="space-y-4">
            <h2 class="text-2xl md:text-3xl font-semibold text-slate-900">
              Limitation of Liability
            </h2>
            <p>
              To the fullest extent permitted by applicable law, Mantiqh shall not be liable for any indirect, incidental, special, consequential, or exemplary damages arising from:
            </p>
            <ul class="list-disc list-inside space-y-1 text-slate-700 pl-4">
              <li>Use of this website.</li>
              <li>Inability to access the website.</li>
              <li>Website interruptions.</li>
              <li>Data loss.</li>
              <li>Business interruption.</li>
              <li>Loss of profits.</li>
              <li>Reliance on website information.</li>
            </ul>
            <p>
              This limitation applies regardless of the legal theory under which any claim arises.
            </p>
          </section>

          {/* Service Engagements */}
          <section class="space-y-4">
            <h2 class="text-2xl md:text-3xl font-semibold text-slate-900">
              Service Engagements
            </h2>
            <p>
              Project timelines, deliverables, pricing, payment schedules, intellectual property ownership, warranties, maintenance, and support obligations are governed exclusively through separate contractual agreements executed between Mantiqh and its clients.
            </p>
            <p>
              Nothing contained within this website constitutes a legally binding commercial offer.
            </p>
          </section>

          {/* Payment Terms */}
          <section class="space-y-4">
            <h2 class="text-2xl md:text-3xl font-semibold text-slate-900">
              Payment Terms
            </h2>
            <p>
              Where applicable, invoices for professional services shall be governed by mutually agreed commercial terms defined within project proposals or contractual agreements.
            </p>
            <p>
              Failure to comply with agreed payment obligations may result in suspension or termination of services.
            </p>
          </section>

          {/* Career Applications */}
          <section class="space-y-4">
            <h2 class="text-2xl md:text-3xl font-semibold text-slate-900">
              Career Applications
            </h2>
            <p>
              Information submitted for employment opportunities will be processed solely for recruitment purposes in accordance with our <a href="/privacy-policy" class="text-blue-600 hover:underline">Privacy Policy</a>.
            </p>
            <p>
              Submission of an application does not guarantee employment or further recruitment processes.
            </p>
          </section>

          {/* Security */}
          <section class="space-y-4">
            <h2 class="text-2xl md:text-3xl font-semibold text-slate-900">
              Security
            </h2>
            <div class="space-y-2">
              <p class="font-medium text-slate-900">Users must not attempt to:</p>
              <ul class="list-disc list-inside space-y-1 text-slate-700 pl-4">
                <li>Gain unauthorized access to servers.</li>
                <li>Reverse engineer website functionality.</li>
                <li>Interfere with security systems.</li>
                <li>Circumvent authentication mechanisms.</li>
                <li>Conduct penetration testing without prior written authorization.</li>
              </ul>
            </div>
            <p>
              Unauthorized activities may result in legal action.
            </p>
          </section>

          {/* Governing Law */}
          <section class="space-y-4">
            <h2 class="text-2xl md:text-3xl font-semibold text-slate-900">
              Governing Law
            </h2>
            <p>
              These Terms & Conditions shall be governed by and interpreted in accordance with the laws of the Republic of India.
            </p>
            <p>
              Any disputes arising from the use of this website shall be subject to the exclusive jurisdiction of the competent courts having jurisdiction over Mantiqh's registered office.
            </p>
          </section>

          {/* Changes to These Terms */}
          <section class="space-y-4">
            <h2 class="text-2xl md:text-3xl font-semibold text-slate-900">
              Changes to These Terms
            </h2>
            <p>
              Mantiqh reserves the right to modify these Terms & Conditions at any time without prior notice.
            </p>
            <p>
              Updated versions will be published on this page together with the revised "Last Updated" date.
            </p>
            <p>
              Continued use of the website following any revisions constitutes acceptance of the updated Terms.
            </p>
          </section>

          {/* Contact Us */}
          <section class="space-y-3">
            <h2 class="text-2xl md:text-3xl font-semibold text-slate-900">
              Contact Us
            </h2>
            <p>
              If you have any questions regarding these Terms & Conditions, please contact us.
            </p>
            <div class="pt-2">
              <p class="font-semibold text-slate-900">Mantiqh</p>
              <p>Email: <a href="mailto:hello@mantiqh.com" class="text-blue-600 hover:underline">hello@mantiqh.com</a></p>
            </div>
          </section>
        </div>
      </main>
    </div>
  </div>
</MainLayout>
