    <main class="relative min-h-[calc(100vh-5rem)]">
      <slot />
    </main>
    <Footer />

    <script>
      import Lenis from "lenis";

      let lenis: Lenis | null = null;

      function initLenis() {
        if (lenis) {
          lenis.destroy();
        }

        lenis = new Lenis({
          lerp: 0.1,
          prevent: (node: Element) => {
            return (
              node.hasAttribute("data-lenis-prevent") ||
              node.closest("[data-lenis-prevent]") !== null
            );
          },
        });

        // Expose lenis instance globally for interactions
        (window as any).lenis = lenis;

        // Synchronize GSAP ScrollTrigger with Lenis scroll updates
        lenis.on("scroll", () => {
          if (window.ScrollTrigger) {
            window.ScrollTrigger.update();
          }
        });

        // If the loader is visible on the home page, stop scroll immediately
        /* const isLoaderVisible =
          document.getElementById("static-loader-overlay")?.style.display !==
          "none";
        if (isLoaderVisible && window.location.pathname === "/") {
          lenis.stop();
        } */

        function raf(time: number) {
          lenis?.raf(time);
          requestAnimationFrame(raf);
        }

        requestAnimationFrame(raf);
      }

      // Initial page load
      initLenis();

      // View Transitions compatibility
      document.addEventListener("astro:page-load", () => {
        if (!lenis) {
          initLenis();
        }
      });

      document.addEventListener("astro:before-swap", () => {
        if (lenis) {
          lenis.destroy();
          lenis = null;
          (window as any).lenis = null;
        }
      });
    </script>
  </body>
</html>
