                  AI
                </span>

                <span class="text-[#454751] text-caption font-normal">
                  May 20, 2026
                </span>
              </div>
            </div>

            {/* Box 3 */}
            <div class="w-full lg:w-1/3 px-6 md:px-8 lg:px-10 py-8">
