---
import Navbar from "../../layout/Navbar.astro";
---

<div class="bg-white">
  <div
    class="bg-white flex flex-col grow max-w-[1440px] mx-auto w-full border-x border-slate-200/20 relative"
  >
    <Navbar theme="light" />
    <div class="text-black pt-10 px-6 lg:px-10">
      <h2 class="text-h2 font-medium">Featured Blogs</h2>
      <p class="text-[#454751] text-h6 font-normal mt-2 max-w-[847px]">
        Explore featured insights, emerging technologies, and strategic
        perspectives shaping the future of AI, digital transformation, and
        modern digital experiences.
      </p>

      <a href="/blogs/ai-powered-enterprise-workflows" class="block">
        <div class="flex flex-col-reverse lg:flex-row pt-10 gap-10">
          {/* LEFT CONTENT */}
          <div class="w-full lg:w-1/2 flex flex-col justify-between">
            <div>
              <h3 class="text-h3 font-medium text-black pb-6 md:pb-50">
                The Rise of AI-Powered Enterprise Workflows
              </h3>

              <p class="text-[#454751] text-body-m font-normal pb-6">
                Businesses across industries are rapidly shifting toward
                AI-powered workflows to improve operational efficiency, automate
                repetitive processes, and unlock faster decision-making. From
                intelligent automation and predictive analytics to AI agents
                capable of handling complex workflows, modern enterprises are
                rethinking how technology integrates into daily operations
              </p>
            </div>

            <div class="flex justify-between items-center w-full pb-6 md:pb-12">
              <div class="flex gap-3">
                <span
                  class="border-[#475569] border-[0.4px] rounded-[2px] py-0.5 px-3 text-black text-caption font-medium"
                >
                  AI
                </span>

                <span
                  class="border-[#475569] border-[0.4px] rounded-[2px] py-0.5 px-3 text-black text-caption font-medium"
                >
                  ENTERPRISE
                </span>
              </div>
              <span class="text-[#454751] text-caption font-normal">
                May 20, 2026
              </span>
            </div>
          </div>

          {/* RIGHT IMAGE */}
          <div class="w-full lg:w-1/2">
            <img
              fetchpriority="high"
              src="/blogs/blogs-ai-img.png"
              alt="AI Enterprise"
              class="w-full h-auto object-cover"
            />
          </div>
        </div>
      </a>

      {/* Bottom Cards */}
      <div>
        <div
          class="relative left-[-24px] w-[calc(100%+48px)] lg:left-[-40px] lg:w-[calc(100%+80px)] border-y-[0.4px] border-[#AAB1BA]"
        >
          <div class="flex flex-col lg:flex-row">
            {/* Box 1 */}
            <div
              class="w-full lg:w-1/3 border-b lg:border-b-0 lg:border-r-[0.4px] border-[#AAB1BA] px-6 md:px-8 lg:px-10 py-8"
            >
              <div class="flex justify-between items-start pb-16 gap-4">
                <h4 class="text-h5 font-medium text-black">
                  Designing Digital Products for Operational Simplicity
                </h4>

                <img
                  src="/blogs/box-1.png"
                  alt="Product Design"
                  loading="lazy"
                  decoding="async"
                  class="w-[52px] h-[52px] object-cover shrink-0"
                />
              </div>

              <p class="text-[#454751] text-body-m font-normal pb-10">
                Why simplifying complex workflows is becoming the foundation of
                successful SaaS and enterprise product experiences...
              </p>

              <div class="flex justify-between items-center gap-4">
                <span
                  class="border-[#475569] border-[0.4px] rounded-[2px] py-0.5 px-3 text-black text-caption font-medium"
                >
                  PRODUCT DESIGN
                </span>

                <span class="text-[#454751] text-caption font-normal">
                  May 20, 2026
                </span>
              </div>
            </div>

            {/* Box 2 */}
            <div
              class="w-full lg:w-1/3 border-b lg:border-b-0 lg:border-r-[0.4px] border-[#AAB1BA] px-6 md:px-8 lg:px-10 py-8"
            >
              <div class="flex justify-between items-start pb-16 gap-4">
                <h4 class="text-h5 font-medium text-black">
                  Building Scalable Platforms for the AI Era
                </h4>

                <img
                  src="/blogs/box-2.png"
                  alt="AI Platform"
                  loading="lazy"
                  decoding="async"
                  class="w-[52px] h-[52px] object-cover shrink-0"
                />
              </div>

              <p class="text-[#454751] text-body-m font-normal pb-10">
                A deep dive into modern architecture strategies, scalable
