---
import { servicesData } from "../../../data/services";
import { ServiceModal } from "../../ui/service-modal";
---

<section class="w-full bg-white border-t border-slate-200">
    <div
        class="max-w-[1440px] mx-auto flex flex-col lg:flex-row border-x border-slate-200"
    >
        <!-- Left Column: Heading -->
        <div
            class="w-full lg:w-[40%] p-8 lg:p-12 flex items-center border-b lg:border-b-0 lg:border-r border-slate-200"
        >
            <h2 class="text-h2 font-medium text-[#0F172A] leading-[140%]">
                Lead In The AI<br />Era With Mantiqh
            </h2>
        </div>

        <!-- Right Column: Services Grid -->
        <div class="w-full lg:w-[60%] grid grid-cols-1 md:grid-cols-2">
            {
                servicesData.map((service, i) => (
                    <div
                        class:list={[
                            "pt-10 pb-8 px-9 group hover:bg-slate-50/50 transition-colors duration-500 cursor-pointer service-card",
                            i % 2 === 0 ? "md:border-r border-slate-200" : "",
                            i < 2
                                ? "border-b border-slate-200"
                                : "border-b md:border-b-0 border-slate-200",
                        ]}
                        data-service-id={service.icon}
                    >
                        <div class="flex gap-5 items-start">
                            <div class="w-8 h-8 flex-shrink-0 flex items-center justify-center text-slate-400">
                                {service.icon === "agent" && (
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="24"
                                        height="24"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="1.25"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    >
                                        <path d="M12 8V4H8" />
                                        <rect
                                            width="16"
                                            height="12"
                                            x="4"
                                            y="8"
                                            rx="2"
                                        />
                                        <path d="M2 14h2" />
                                        <path d="M20 14h2" />
                                        <path d="M15 13v2" />
                                        <path d="M9 13v2" />
                                    </svg>
                                )}
                                {service.icon === "automation" && (
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="24"
                                        height="24"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="1.25"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    >
                                        <path d="M11 20H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v7" />
                                        <path d="M16 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z" />
                                        <path d="m22 18-3.5-3.5" />
                                        <path d="M12 11h4" />
                                    </svg>
                                )}
                                {service.icon === "analytics" && (
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="24"
                                        height="24"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="1.25"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    >
                                        <path d="M21.21 15.89A10 10 0 1 1 8 2.83" />
                                        <path d="M22 12A10 10 0 0 0 12 2v10z" />
                                    </svg>
                                )}
                                {service.icon === "consulting" && (
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="24"
                                        height="24"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="1.25"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    >
                                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                                        <circle cx="9" cy="7" r="4" />
                                        <line x1="19" x2="19" y1="8" y2="14" />
                                        <line x1="22" x2="16" y1="11" y2="11" />
                                    </svg>
                                )}
                            </div>

                            <div class="flex flex-col gap-4">
                                <h3 class="text-h6 font-medium text-[#0F172A] leading-[130%]">
                                    {service.title}
                                </h3>
                                <p class="text-[#454751] text-body-s leading-[160%]">
                                    {service.desc}
                                </p>
                                <a
                                    href="#"
                                    aria-label={`Read more about ${service.title}`}
                                    class="inline-flex items-center gap-2 text-[#387EC1] font-bold text-caption hover:gap-3 transition-all duration-300 w-fit"
                                >
                                    Read More
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="16"
                                        height="16"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    >
                                        <path d="m9 18 6-6-6-6" />
                                    </svg>
                                </a>
                            </div>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<ServiceModal client:load />

<script>
    const serviceCards = document.querySelectorAll('.service-card');
    serviceCards.forEach(card => {
        card.addEventListener('click', (e) => {
            e.preventDefault();
            const serviceId = card.getAttribute('data-service-id');
            if (serviceId) {
                window.dispatchEvent(new CustomEvent('open-service-modal', {
                    detail: { serviceId: serviceId }
                }));
            }
        });
    });
</script>
