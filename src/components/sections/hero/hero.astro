---
import LogoCarousel from "../LogoCarousel.astro";
import FlowLines from "../../visuals/FlowLines.astro";
import Navbar from "../../layout/Navbar.astro";
import ChevronRight from "../../ui/ChevronRight.astro";
import { heroBrands, heroContent } from "../../../data/hero";
---

<div
  class="bg-midnight-500 w-full h-screen min-h-[659px] relative overflow-hidden flex flex-col"
>
  <div
    class="flex flex-col flex-grow max-w-[1440px] mx-auto w-full border-x border-slate-200/20 relative"
  >
    <Navbar />
    <FlowLines
      lineColor="#ffffff"
      backgroundColor="transparent"
      waveSpeedX={0.0125}
      waveSpeedY={0.0}
      waveAmpX={15}
      waveAmpY={0}
      friction={0.7}
      tension={0.01}
      maxCursorMove={120}
      xGap={12}
      yGap={36}
    />

    <!-- Refined Right-Angle Triangle Shape (Now z-5 to hide lines) -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none z-5">
      <!-- Over-extended container on all sides to keep edges solid -->
      <div
        class="absolute -left-[300px] -right-[1200px] -bottom-[200px] h-[calc(90%+400px)] blur-[120px]"
      >
        <div
          class="absolute inset-0 bg-[#105AA0]"
          style="clip-path: polygon(0% 35%, 100% 100%, 0% 100%);"
        >
        </div>
      </div>
    </div>

    <div
      class="flex-grow flex items-center md:items-end px-6 lg:px-[3.20%] pt-24 md:pt-0 pb-16 relative z-20"
    >
      <div class="flex flex-col gap-6 w-full">
        <p class="text-body-xs font-medium leading-[140%] mb-1 md:mb-3">
          {heroContent.subtitle}
        </p>
        <div class="w-full lg:w-[70%] mb-8 md:mb-16">
          <h1 class="text-display font-medium leading-[110%] mb-4">
            {heroContent.title}
          </h1>
          <p class="text-body-m leading-[130%] font-normal w-full md:w-[75%]">
            {heroContent.description}
          </p>
        </div>
        <div class="flex gap-3">
          <a href="/get-in-touch">
            <button
              class="flex items-center gap-2 h-[42px] px-5 rounded-lg bg-deep-blue-500 hover:bg-deep-blue-600 transition-all duration-300 shadow-lg shadow-deep-blue-500/20 cursor-pointer group"
            >
              <span class="text-body-s font-medium"
                >{heroContent.primaryButton}</span
              >
              <ChevronRight
                className="text-white transition-transform duration-300 group-hover:translate-x-1"
              />
            </button>
          </a>
          <a href="/work#projects-section-wrapper">
            <button
              class="flex items-center gap-2 h-[42px] px-5 rounded-lg text-white hover:bg-white/5 transition-all duration-300 ease-in-out border border-slate-200/30 cursor-pointer group"
            >
              <span class="text-body-s font-medium"
                >{heroContent.secondaryButton}</span
              >
              <ChevronRight
                className="text-white transition-transform duration-300 group-hover:translate-x-1"
              />
            </button>
          </a>
        </div>
      </div>
    </div>
    <div class="w-full bg-midnight-500 z-20 border-t border-white/10">
      <LogoCarousel logos={heroBrands} gap={0} />
    </div>
  </div>
</div>
