---
import { showcaseProjects, showcaseHeader, showcaseImpactHeader } from "../../../data/showcase";
import ChevronRight from "../../ui/ChevronRight.astro";
---

<section class="relative w-full max-w-[1440px] mx-auto bg-midnight-500 showcase-noise" id="showcase-trigger">
    <!-- Indicators Space Wrapper (Handles global clipping) -->
    <div class="w-full md:max-w-[1440px] md:mx-auto relative overflow-visible px-6 md:px-0">
        
        <!-- Pinned Container -->
        <div class="h-auto md:h-[calc(100dvh-90px)] lg:h-[calc(100vh-90px)] w-full flex flex-col border-x border-slate-200/20 overflow-visible py-10 md:py-0">
            <!-- Header Row (Icons) -->
            <div class="flex flex-col md:flex-row bg-midnight-500 z-30 showcase-noise pb-6 md:pb-0">
                <div
                    class="project-header-col w-full md:w-[40%] lg:w-[29%] xl:w-[28%] h-auto md:h-[130px] md:border-r border-slate-200/20 flex items-center justify-center md:justify-start md:items-end pb-4 md:pb-6 px-0 md:px-6 relative"
                >
                    <!-- Static Initial Indicator (01) -->
                   <div
    id="header-indicator-abs"
    class="absolute left-[-64px] md:left-[-80px] w-12 hidden 2xl:block"
    style="bottom: 0px;"
>
    <div class="w-full h-[1px] bg-white/20"></div>
    <span class="absolute top-2 left-0 text-[11px] font-medium text-white/40">01</span>
</div>

                    <!-- Project Icons -->
                    <div class="flex gap-3 sm:gap-4 overflow-visible shrink-0 max-w-full">
                        {showcaseProjects.map((project, i) => (
                            <div 
                                class:list={[
                                    "project-icon-block w-[45px]   h-[45px] sm:w-[56px] sm:h-[56px] md:w-12 md:h-12 rounded-lg flex items-center justify-center transition-all duration-500 overflow-hidden shrink-0",
                                    i === 0 ? "bg-white shadow-lg shadow-white/5" : "bg-white/5 border border-white/10"
                                ]}
                            >
                                <img 
                                    src={`/svgs/showcase/${project.svg}`} 
                                    alt="brand" 
                                    loading="lazy"
                                    decoding="async"
                                    class:list={[
                                        "project-icon w-full h-full object-contain transition-all duration-500",
                                        i === 0 ? "brightness-100" : "brightness-0 invert opacity-40"
                                    ]} 
                                />
                            </div>
                        ))}
                    </div>

                    <!-- Header Progress Line (Step 01) -->
                    <div class="absolute bottom-0 left-0 right-0 md:left-6 md:right-6 h-[1px] bg-white/5 overflow-hidden hidden md:block">
                        <div id="header-progress-line" class="absolute left-0 top-0 h-full w-full bg-white/60" />
                    </div>
                </div>
                <div class="project-header-title-col flex w-full md:w-[72%] items-center justify-start md:items-end pl-4 md:px-10 h-auto pt-2 pb-0 md:pb-6">
                    <span class="text-deep-blue-500 text-body-sm font-bold leading-[160%] uppercase">
                        {showcaseHeader}
                    </span>
                </div>
            </div>

            <div class="flex-grow relative" style="clip-path: inset(0 0 0 -200px); -webkit-clip-path: inset(0 0 0 -200px);">
                {showcaseProjects.map((project, i) => (
                    <div
                        class:list={[
                            "slide relative md:absolute md:inset-0 w-full h-auto md:h-full bg-[#1e2235] md:bg-midnight-500 showcase-noise rounded-none md:rounded-md border border-white/5 md:border-none shadow-2xl md:shadow-none mb-8 md:mb-0 overflow-hidden md:overflow-visible",
                            i === 0 ? "md:z-10" : "md:z-20"
                        ]}
                    >
                        <!-- Slide Progress Line (Stacked at the top, same as header) -->
                        {i > 0 && (
                            <div 
                                class="slide-progress-line-container absolute left-0 right-auto w-[35%] md:left-6 md:w-[calc(28%-48px)] h-[1px] bg-white/5 overflow-hidden z-[60] opacity-0 hidden md:block"
                                style={`top: 0px;`}
                            >
                                <div class="slide-progress-line absolute left-0 top-0 h-full w-0 bg-deep-blue-500" />
                            </div>
                        )}

                        <!-- Slide Indicator (02+) -->
                       {i > 0 && (
    <div
        class="slide-indicator absolute left-[-64px] md:left-[-80px] w-12 hidden 2xl:block opacity-0"
        style={`top: ${i * 18}px;`}
    >
        <div class="w-full h-[1px] bg-white/20"></div>
        <span class="absolute top-2 left-0 text-[11px] font-medium text-white/40">
            0{i + 1}
        </span>
    </div>
)}

                        <!-- Slide Content -->
                        <div class="flex flex-col md:flex-row h-full overflow-hidden">
                            
                            <!-- Left Column: Visuals/Mockups -->
                            <div class="flex h-[220px] md:h-full w-full md:w-[40%] lg:w-[29%] xl:w-[28%] bg-white/5 md:bg-transparent md:border-r border-slate-200/20    flex-col relative overflow-hidden flex-shrink-0">
                                <div class="showcase-img-wrapper flex-1 flex items-center justify-center p-6 md:px-0 md:pt-4 lg:px-0 lg:pt-6">
                                    <div class="relative w-full h-full flex items-center justify-center group">
                                        <img 
                                            src={project.image} 
                                            alt={project.title} 

                                            class="max-w-full max-h-full object-contain relative z-10"
                                        />
                                        <div class="absolute inset-0 bg-deep-blue-500/10 blur-3xl rounded-full scale-100 opacity-0 group-hover:opacity-100 transition-opacity duration-700" />
                                    </div>
                                </div>
                            </div>

                            <!-- Right Column: Text Content -->
                            <div class="w-full md:h-full md:w-[72%] flex flex-col flex-shrink-0">
                                <div class="showcase-text-container flex flex-col gap-4 md:gap-5 p-6 sm:p-8 md:px-10 md:py-4 overflow-y-auto no-scrollbar max-h-full" data-lenis-prevent>
                                    <div>
                                        <h2 class="text-h4 font-medium text-white leading-[130%] ">
                                            {project.title}
                                        </h2>
                                        <p class="text-body-sm text-[#E8E8E9] mt-2 md:mt-3 md:w-[400px] lg:w-2xl leading-[160%]">
                                            {project.desc}
                                        </p>
                                        <a href={`/work/${project.slug}`} aria-label={`Learn more about ${project.title}`} class="block mt-4 md:mt-4 w-fit">
                                            <button class="flex items-center gap-2 px-6 md:px-8 py-2.5 md:py-3 border border-slate-200/20 rounded-lg text-white text-body-xs hover:bg-white/5 transition-all duration-300 w-fit cursor-pointer group">
                                                <span>Learn More</span>
                                                <ChevronRight className="text-white transition-transform duration-300 group-hover:translate-x-1" />
                                            </button>
                                        </a>
                                    </div>
                                    
                                    <div class="showcase-impact-section border-t border-slate-200/10 pt-4 md:pt-4">
                                        <span class="text-deep-blue-500 text-body-xs font-bold leading-[160%] uppercase">
                                            {showcaseImpactHeader}
                                        </span>
                                        <div class="showcase-impact-list flex flex-col gap-3 md:gap-3 mt-3 md:mt-4">
                                            {project.impact.map((item) => (
                                                <div class="flex items-start gap-4">
                                                    <div class="w-2 h-2 bg-white mt-1.5 shrink-0" />
                                                    <div class="flex flex-col">
                                                        <span class="text-white text-body-xs font-bold leading-[160%]">{item.value}</span>
                                                        <span class="text-slate-300 text-body-xs md:w-[400px] mt-[2px] leading-[160%]">{item.label}</span>
                                                    </div>
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </div>

</section>

<script>
    import gsap from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);
    if (typeof window !== "undefined") {
        (window as any).ScrollTrigger = ScrollTrigger;
    }

    const slides = document.querySelectorAll(".slide");
    const trigger = document.querySelector("#showcase-trigger");
    const iconBlocks = document.querySelectorAll(".project-icon-block");

    if (trigger && slides.length > 0) {
        let mm = gsap.matchMedia();

        mm.add("(min-width: 768px)", () => {
            const tl = gsap.timeline({
                scrollTrigger: {
                    trigger: trigger,
                    start: "top 90px",
                    end: "+=400%",
                    scrub: 0.5,
                    pin: true,
                },
            });

            // Slide Animations
            slides.forEach((slide, i) => {
                // Animation for each transition
                const startTime = i - 1; 

                if (i > 0) {
                    // Set initial state via GSAP to prevent conflicts with Tailwind CSS translate properties
                    gsap.set(slide, { yPercent: 100 });

                    // Animate slide up
                    tl.to(slide, {
                        yPercent: 0,
                        duration: 1,
                        ease: "power2.inOut",
                    }, startTime);



                    // Animate header icons
                    if (iconBlocks[i-1]) {
                        // Fade out previous icon (snap)
                        tl.to(iconBlocks[i-1], {
                            backgroundColor: "rgba(255, 255, 255, 0.05)",
                            borderColor: "rgba(255, 255, 255, 0.1)",
                            duration: 0.1
                        }, startTime + 0.9);
                        
                        const prevImg = iconBlocks[i-1].querySelector("img");
                        if (prevImg) {
                            tl.to(prevImg, {
                                filter: "brightness(0) invert(1)",
                                opacity: 0.4,
                                duration: 0.1
                            }, startTime + 0.9);
                        }
                    }

                    if (iconBlocks[i]) {
                        // Pop active icon (snap)
                        tl.to(iconBlocks[i], {
                            backgroundColor: "rgba(255, 255, 255, 1)",
                            borderColor: "rgba(255, 255, 255, 1)",
                            duration: 0.1
                        }, startTime + 0.9);

                        const activeImg = iconBlocks[i].querySelector("img");
                        if (activeImg) {
                            tl.to(activeImg, {
                                filter: "brightness(1) invert(0)",
                                opacity: 1,
                                duration: 0.1
                            }, startTime + 0.9);
                        }
                    }

                    // Animate indicator fade in
                    const indicator = slide.querySelector(".slide-indicator");
                    const progressLineContainer = slide.querySelector(".slide-progress-line-container");

                    if (indicator) {
                        tl.to(indicator, {
                            opacity: 1,
                            duration: 0.5,
                        }, startTime + 0.3);
                    }

                    if (progressLineContainer) {
                        tl.to(progressLineContainer, {
                            opacity: 1,
                            duration: 0.5,
                        }, startTime + 0.3);
                    }

                    // Animate progress line in the column
                    const progressLine = slide.querySelector(".slide-progress-line");
                    if (progressLine) {
                        tl.to(progressLine, {
                            width: "100%",
                            duration: 1,
                            ease: "none",
                        }, startTime);
                    }
                }

                // Animate previous progress line (empty out)
                if (i < slides.length - 1) {
                    const currentLine = i === 0 
                        ? document.querySelector("#header-progress-line") 
                        : slides[i].querySelector(".slide-progress-line");
                    
                    const currentIndicator = i === 0
                        ? document.querySelector("#header-indicator-abs")
                        : slides[i].querySelector(".slide-indicator");

                    if (currentLine) {
                        tl.to(currentLine, {
                            left: "100%",
                            width: "0%",
                            duration: 1,
                            ease: "power2.inOut"
                        }, i); // Empties when NEXT slide comes in
                    }

                    if (currentIndicator) {
                        const indicatorText = currentIndicator.querySelector("span");
                        
                        if (indicatorText) {
                            tl.to(indicatorText, {
                                opacity: 0,
                                duration: 0.05,
                            }, i + 0.95);
                        }
                    }
                }
            });

            // Smooth scroll helper for icon click navigation
            function smoothScrollTo(targetY: number, duration = 800) {
                const startY = window.scrollY;
                const distance = targetY - startY;
                const startTime = performance.now();

                function step(currentTime: number) {
                    const elapsed = currentTime - startTime;
                    const progress = Math.min(elapsed / duration, 1);
                    // easeInOutCubic
                    const ease = progress < 0.5
                        ? 4 * progress * progress * progress
                        : 1 - Math.pow(-2 * progress + 2, 3) / 2;
                    window.scrollTo(0, startY + distance * ease);
                    if (progress < 1) requestAnimationFrame(step);
                }
                requestAnimationFrame(step);
            }

            // Icon click navigation
            iconBlocks.forEach((icon, i) => {
                (icon as HTMLElement).style.cursor = 'pointer';
                icon.addEventListener('click', () => {
                    const st = tl.scrollTrigger;
                    if (st) {
                        const totalSlides = slides.length;
                        const progress = totalSlides > 1 ? i / (totalSlides - 1) : 0;
                        const targetScroll = st.start + progress * (st.end - st.start);
                        smoothScrollTo(targetScroll, 800);
                    }
                });
            });
        });
    }
</script>

<style>
    /* Ensure the sticky container stays fixed while scrolling through the spacer */
    #showcase-trigger {
        position: relative;
    }

    /* Hide scrollbar for Chrome, Safari and Opera */
    .no-scrollbar::-webkit-scrollbar {
        display: none;
    }

    /* Hide scrollbar for IE, Edge and Firefox */
    .no-scrollbar {
        -ms-overflow-style: none;  /* IE and Edge */
        scrollbar-width: none;  /* Firefox */
    }

    /* Cofactr-style noise grain — applied directly to element backgrounds */
    .showcase-noise {
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='1' seed='8000'/%3E%3CfeComponentTransfer result='a'%3E%3CfeFuncA type='discrete' tableValues='0 1'/%3E%3C/feComponentTransfer%3E%3CfeFlood flood-color='%230a0d18' result='f'/%3E%3CfeComposite operator='in' in2='a' in='f'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.2'/%3E%3C/svg%3E");
        background-size: 512px 512px;
        background-repeat: repeat;
        background-blend-mode: overlay;
        animation: noise 3s steps(5) infinite;
    }

    @keyframes noise {
        0% { background-position: 0 0; }
        20% { background-position: -100px 50px; }
        40% { background-position: 50px -100px; }
        60% { background-position: -50px 100px; }
        80% { background-position: 100px -50px; }
        100% { background-position: 0 0; }
    }

    /* Responsive indicators layout overrides to replace the Windows zoom hack */
    #header-indicator-abs,
    .slide-indicator {
        left: 24px !important;
    }

    @media (min-width: 1600px) {
        #header-indicator-abs,
        .slide-indicator {
            left: -80px !important;
        }
    }

    @media (max-width: 1023px) {
        #header-indicator-abs,
        .slide-indicator {
            left: 16px !important;
        }
    }

    /* Optimize spacing for shorter viewport heights (common on laptops/scaled displays) */
    @media (max-height: 820px) and (min-width: 768px) {
        .project-header-col {
            height: 90px !important;
            padding-bottom: 12px !important;
        }
        .project-header-title-col {
            padding-bottom: 12px !important;
        }
        .showcase-img-wrapper {
            padding-top: 12px !important;
            padding-bottom: 12px !important;
        }
        .showcase-text-container {
            gap: 12px !important;
            padding-top: 12px !important;
            padding-bottom: 12px !important;
        }
        .showcase-text-container p {
            margin-top: 6px !important;
        }
        .showcase-text-container a {
            margin-top: 10px !important;
        }
        .showcase-text-container button {
            padding-top: 6px !important;
            padding-bottom: 6px !important;
        }
        .showcase-impact-section {
            padding-top: 12px !important;
        }
        .showcase-impact-list {
            margin-top: 10px !important;
            gap: 8px !important;
        }
    }

    @media (max-height: 720px) and (min-width: 768px) {
        .project-header-col {
            height: 80px !important;
            padding-bottom: 8px !important;
        }
        .project-header-title-col {
            padding-bottom: 8px !important;
        }
        .showcase-img-wrapper {
            padding-top: 8px !important;
            padding-bottom: 8px !important;
        }
        .showcase-text-container {
            gap: 8px !important;
            padding-top: 8px !important;
            padding-bottom: 8px !important;
        }
        .showcase-text-container a {
            margin-top: 6px !important;
        }
        .showcase-impact-section {
            padding-top: 8px !important;
        }
        .showcase-impact-list {
            margin-top: 6px !important;
            gap: 6px !important;
        }
    }
</style>
