---
const { solution } = Astro.props;
---

 <!-- Resources Heading -->
  <div class="bg-white"> 
  <section class="bg-white flex flex-col grow max-w-[1440px] mx-auto w-full border-x border-slate-200/20 relative"> 
          <div>
            <h2
              class="text-h4 lg:text-h2 font-medium leading-[1.05] text-[#111827] py-10 px-6 lg:px-10"
            >
              {solution.resources?.title}
            </h2>
          </div>
        

      <div class="border-y-[0.4px] border-slate-200/40">
        <div class="flex flex-col lg:flex-row">
          {
            solution.resources.items.map((item: any, index: number) => (
              <div
                class={`w-full lg:w-1/3 px-6 md:px-8 lg:px-10 py-8 ${
                  index !== solution.resources.items.length - 1
                    ? "border-b lg:border-b-0 lg:border-r-[0.4px] border-slate-200/40"
                    : ""
                }`}
              >
                <div class="flex justify-between items-start pb-8 lg:pb-16 gap-4">
                  <h4 class="text-h6 lg:text-h5 font-medium text-black">{item.title}</h4>

                  <img
                    src={item.image}
                    alt={item.title}
                    class="w-[52px] h-[52px] object-cover shrink-0"
                    
                    
                  />
                </div>

                <p class="text-[#454751] text-body-m font-normal pb-6 lg:pb-10">
                  {item.description}
                </p>

                <div class="flex justify-between items-center gap-4">
                  <span class="border-slate-300 border-[0.4px] bg-slate-50 rounded-[2px] py-0.5 px-3 text-slate-500 text-caption font-medium">
                    {item.tag}
                  </span>

                  <span class="text-[#454751] text-caption font-normal">
                    {item.date}
                  </span>
                </div>
              </div>
            ))
          }
        </div>
        </section>
        </div>