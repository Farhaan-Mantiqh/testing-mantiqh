---
const { solution } = Astro.props;
---
<div class="bg-white"> 
 <section class="bg-white flex flex-col grow max-w-[1440px] mx-auto w-full border-x border-slate-200/20 relative">
        <div class="max-w-[1440px] mx-auto px-6 lg:px-10 pb-10 lg:pb-20">
          <!-- Heading -->
          <div class="text-center">
            <h2
              class="text-h2 font-medium leading-[1.1] text-[#111827]"
            >
              {solution.innovation?.title}
            </h2>

            <!-- Tabs -->
            <div class="mt-8 flex justify-center">
              <div
                class="inline-flex items-center rounded-full border border-[#D9DDE3] p-1"
              >
                <button
                  id="industries-btn"
                  class="rounded-full bg-[#479EE3] px-5 py-2 text-h6 font-medium text-white transition-all cursor-pointer"
                >
                  Industries
                </button>

                <button
                  id="usecases-btn"
                  class="rounded-full px-5 py-2 text-h6 font-medium text-[#111827] transition-all cursor-pointer"
                >
                  Use Cases
                </button>
              </div>
            </div>
          </div>

          <!-- INDUSTRIES -->
          <div
            id="industries-content"
            class="mt-12 max-w-[1100px] mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 border border-[#D9DDE3]"
          >
            {
              solution.innovation.industries.map((item: any) => (
                <div class="group border-r border-b border-[#D9DDE3] p-6 lg:p-8 min-h-[160px] cursor-pointer transition-all duration-300 hover:bg-[#171925]">
                  <div class="flex items-start justify-between gap-4">
                    <h3 class="text-body-l font-normal text-[#111827] transition-colors duration-300 group-hover:text-white">
                      {item.title}
                    </h3>

                    <span class="shrink-0 bg-[#EEF4FB] px-2 py-1 text-[11px] font-medium text-[#479EE3]">
                      {item.number}
                    </span>
                  </div>

                  <p class="mt-4 text-body-s font-normal leading-relaxed text-[#6B7280] transition-colors duration-300 group-hover:text-white/70">
                    {item.description}
                  </p>
                </div>
              ))
            }
          </div>

          <!-- USE CASES -->
          <div
            id="usecases-content"
            class="hidden mt-12 max-w-[1100px] mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 border border-[#D9DDE3]"
          >
            {
              solution.innovation?.useCases?.map((item: any) => (
                <div class="group border-r border-b border-[#D9DDE3] p-6 lg:p-8 min-h-[160px] cursor-pointer transition-all duration-300 hover:bg-[#171925]">
                  <div class="flex items-start justify-between gap-4">
                    <h3 class="text-body-l font-normal text-[#111827] transition-colors duration-300 group-hover:text-white">
                      {item.title}
                    </h3>

                    <span class="shrink-0 bg-[#EEF4FB] px-2 py-1 text-[11px] font-medium text-[#479EE3]">
                      {item.number}
                    </span>
                  </div>

                  <p class="mt-4 text-body-s font-normal leading-relaxed text-[#6B7280] transition-colors duration-300 group-hover:text-white/70">
                    {item.description}
                  </p>
                </div>
              ))
            }
          </div>
        </section>
        </div>