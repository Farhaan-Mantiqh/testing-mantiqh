                        <circle cx="64.4807" cy="352.909" r="2" class="cap-bubble-blue design-bubble-a"/>
                        <circle cx="472.644" cy="335.77" r="2" class="cap-bubble-blue design-bubble-c"/>
                        <circle cx="251.77" cy="189.77" r="2" class="cap-bubble-gray design-bubble-b"/>
                        <circle cx="79.009" cy="323.28" r="2" class="cap-bubble-blue design-bubble-b"/>
                        <circle cx="419.98" cy="306.618" r="2" class="cap-bubble-blue design-bubble-a"/>
                      </g>
                      <defs>
                        <clipPath id="cap-clip0">
                          <rect width="504" height="400" rx="4" fill="white"/>
