<style>
  /* ===== Bubble float animations ===== */
  :global(.design-bubble-a) {
    animation: float-bubble-a 2.2s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: center;
  }
  :global(.design-bubble-b) {
    animation: float-bubble-b 2.7s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: center;
  }
  :global(.design-bubble-c) {
    animation: float-bubble-c 3.1s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: center;
  }
  @keyframes float-bubble-a {
    0%, 100% { transform: translateY(0px) translateX(0px); }
    50% { transform: translateY(-10px) translateX(6px); }
  }
  @keyframes float-bubble-b {
    0%, 100% { transform: translateY(0px) translateX(0px); }
    50% { transform: translateY(8px) translateX(-7px); }
  }
  @keyframes float-bubble-c {
    0%, 100% { transform: translateY(0px) translateX(0px); }
    50% { transform: translateY(-11px) translateX(-5px); }
  }

  /* ===== Bubble dot colors ===== */
  :global(.cap-bubble-dark) {
    fill: #171925;
    transition: fill 0.3s ease;
  }
  :global(.group:hover .cap-bubble-dark) { fill: #ffffff; }

  :global(.cap-bubble-gray) {
    fill: #64656D;
    transition: fill 0.3s ease;
  }
  :global(.group:hover .cap-bubble-gray) { fill: #ffffff; }

  :global(.cap-bubble-blue) {
    fill: #4EAEF9;
    transition: transform 0.3s ease;
  }
  :global(.group:hover .cap-bubble-blue) {
    animation: cap-bubble-pulse 1.5s ease-in-out infinite alternate;
  }
  @keyframes cap-bubble-pulse {
    0%   { transform: scale(1); }
    100% { transform: scale(1.35); }
  }

  /* ===== Background ring circles ===== */
  :global(.cap-ring) {
    stroke: #AAB1BA;
    transition: stroke 0.4s ease;
  }
  :global(.group:hover .cap-ring) {
    stroke: rgba(78, 174, 249, 0.3);
  }

</style>

