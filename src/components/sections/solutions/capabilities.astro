                            <rect x="80" y="200" width="240" height="190" rx="4" fill="#D2E8FF"/>
                            <rect x="80" y="200" width="240" height="14" rx="4" fill="#BDE0FF"/> <!-- Subtle header -->
                            
                            <!-- Window Content -->
                            <rect x="100" y="235" width="20" height="20" rx="4" fill="#4EAEF9"/>
                            <rect x="130" y="238" width="120" height="4" rx="2" fill="#4EAEF9" fill-opacity="1"/>
