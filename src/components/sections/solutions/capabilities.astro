---
const { solution } = Astro.props;

import {
  BrainCircuit,
  ChartColumnIncreasing,
  MessageSquare,
  Network,
  Sparkles,
  Workflow,
} from "lucide-react";
import ChallengesIcon from "./ChallengesIcon";
---

<!-- CAPABILITIES SECTION -->
<div class="bg-white">
  <section
    class="bg-white flex flex-col grow max-w-[1440px] mx-auto w-full border-x border-slate-200/20 relative"
  >
    <div class="max-w-[1440px] mx-auto px-6 lg:px-10 py-10">
      <h2
        class="text-h2 font-medium leading-tight text-[#111827]"
      >
        {solution.capabilities?.title}
      </h2>

      <div class="mt-10 space-y-4">
        <!-- ROW 1 -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-8 gap-4">
          <!-- BIG -->
          <div
            class="group lg:col-span-4 border border-[#D9DDE3] bg-white p-6 md:p-8 min-h-[400px] md:min-h-[500px] flex flex-col cursor-pointer transition-all duration-300 hover:bg-[#171925] overflow-hidden relative"
          >
            <div class="relative z-10">
              <ChallengesIcon
  icon={solution.capabilities.cards[0].icon}
  className="text-[#387EC1] transition-colors duration-300 group-hover:text-[#E8E8E9]"
/>
            </div>

            <h3
              class="mt-6 text-h5 font-normal text-[#111827] transition-colors duration-300 group-hover:text-[#E8E8E9] relative z-10"
            >
              {solution.capabilities?.cards?.[0]?.title}
            </h3>

            <p
              class="mt-4 w-full text-[#6B7280] text-body-s font-normal transition-colors duration-300 group-hover:text-[#E8E8E9] relative z-10"
            >
              {solution.capabilities?.cards?.[0]?.description}
            </p>

            <!-- IMAGE SPACE - Inline SVG with animated bubbles -->
            {
              solution.capabilities?.cards?.[0]?.image && (
                <div
                  class="mt-auto -mx-6 md:-mx-8 -mb-6 md:-mb-8 overflow-hidden"
                  style="aspect-ratio: 504 / 250;"
                >
                  {/* AI/ML — isometric cubes */}
                  {solution.capabilities.cards[0].image.startsWith('/') && (
                    <svg width="100%" height="100%" viewBox="0 0 504 400" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMax slice">
                      <g clip-path="url(#cap-clip0)">
                        <circle cx="252" cy="369" r="199.9" stroke="#AAB1BA" stroke-width="0.2" class="cap-ring"/>
                        <circle cx="252" cy="369" r="149.9" stroke="#AAB1BA" stroke-width="0.2" stroke-dasharray="4 4" class="cap-ring"/>
                        <circle cx="252" cy="369" r="99.9" stroke="#AAB1BA" stroke-width="0.2" class="cap-ring"/>
                        <path d="M252.752 247.615V322.384L188 359.77L123.248 322.384V247.615L188 210.229L252.752 247.615Z" fill="#4EAEF9" stroke="#171925" stroke-width="0.4"/>
                        <line x1="123.697" y1="247.883" x2="188.095" y2="282.574" stroke="#171925" stroke-width="0.4"/>
                        <line x1="123.697" y1="257.883" x2="188.095" y2="292.574" stroke="#171925" stroke-width="0.4"/>
                        <line x1="187.8" y1="359.25" x2="187.8" y2="282" stroke="#171925" stroke-width="0.4"/>
                        <line y1="-0.2" x2="73.8093" y2="-0.2" transform="matrix(-0.884035 0.467421 0.467421 0.884035 252.5 248.25)" stroke="#171925" stroke-width="0.4"/>
                        <line y1="-0.2" x2="73.8093" y2="-0.2" transform="matrix(-0.884035 0.467421 0.467421 0.884035 252.5 258.25)" stroke="#171925" stroke-width="0.4"/>
