                        <circle cx="366.539" cy="198.54" r="4" class="cap-bubble-blue design-bubble-b"/>
                        <circle cx="42.3525" cy="325.353" r="4" class="cap-bubble-dark design-bubble-b"/>
                        <circle cx="442.539" cy="354.282" r="4" class="cap-bubble-dark design-bubble-c"/>
