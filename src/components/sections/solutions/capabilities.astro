                            <rect x="130" y="293" width="110" height="4" rx="2" fill="#4EAEF9" fill-opacity="0.8"/>

                            <!-- Solid Blue Front Window -->
                            <rect x="160" y="160" width="260" height="200" rx="4" fill="#4EAEF9"/>
                            
