---
interface Props {
    logos: string[];
    speed?: number;
    gap?: number;
    className?: string;
    pauseOnHover?: boolean;
    fadeOut?: boolean;
}

const {
    logos,
    speed = 50,
    gap = 32,
    className = "",
    pauseOnHover = true,
} = Astro.props;
---

<div
    class:list={[
        "logo-carousel-container relative overflow-hidden py-6 mx-auto",
        className,
    ]}
    data-speed={speed}
    data-gap={gap}
    data-pause={pauseOnHover}
    style={{
        width: `${190 * 4 + gap * 3}px`,
    }}
>
    <div
        class="logo-carousel-track flex items-center w-max cursor-pointer"
        style={{ gap: `${gap}px` }}
    >
        {
            /* Triple the items to ensure enough width for any screen size and smooth looping */
        }
        {
            [...logos, ...logos, ...logos].map((logo) => (
                <div class="logo-item flex-shrink-0">
                    <img
                        src={logo}
                        alt={`Partner Logo - ${logo.split('/').pop()?.split('.')[0] || 'Brand'}`}
                        width="180"
                        height="60"
                        class="w-[180px] h-[60px] object-contain pointer-events-none select-none"
                        draggable="false"
                        
                        
                    />
                </div>
            ))
        }
    </div>
</div>

<script>
    import gsap from "gsap";

    function initCarousel() {
        const containers = document.querySelectorAll(
            ".logo-carousel-container",
        );

        containers.forEach((container) => {
            const track = container.querySelector(
                ".logo-carousel-track",
            ) as HTMLElement;
            if (!track) return;

            const speed = parseFloat(
                container.getAttribute("data-speed") || "50",
            );
            const pauseOnHover =
                container.getAttribute("data-pause") === "true";

            // Calculate total width of one set of logos
            // Since we tripled the logos, we want to animate across 1/3 of the total track width
            const totalWidth = track.scrollWidth / 3;

            const tl = gsap.to(track, {
                x: -totalWidth,
                duration: totalWidth / speed,
                ease: "none",
                repeat: -1,
            });

            if (pauseOnHover) {
                container.addEventListener("mouseenter", () => tl.pause());
                container.addEventListener("mouseleave", () => tl.play());
            }
        });
    }

    // Initialize on page load
    initCarousel();

    // Re-initialize on View Transitions (if used)
    document.addEventListener("astro:after-swap", initCarousel);
</script>
