<style>
  .design-pie-chart {
    transform-origin: 131.5px 312px;
    transition: transform 0.5s ease-out;
  }

  .group:hover .design-pie-chart {
    transition: none;
    animation: spin-continuous 0.8s ease-in-out 1;
  }

  .design-pie-chart path:first-child {
    transition: fill 0.3s ease;
  }

  .group:hover .design-pie-chart path:first-child {
    fill: #71befa !important;
  }

  @keyframes spin-continuous {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes stroke-move-forward {
    to {
      stroke-dashoffset: -16;
    }
  }

  @keyframes stroke-move-reverse {
    to {
      stroke-dashoffset: 16;
    }
  }

  .animate-line-1 {
    animation: stroke-move-forward 1.5s linear infinite;
  }
  .animate-line-2 {
    animation: stroke-move-reverse 1.5s linear infinite;
  }
  .animate-line-3 {
    animation: stroke-move-forward 1.5s linear infinite;
  }

  .custom-line-1-2 {
    stroke: #64656d;
    transition: stroke 0.3s ease;
  }
  .custom-line-3 {
    stroke: #b7b8bb;
    transition: stroke 0.3s ease;
  }

  .cursor-stroke {
    stroke: black;
    transition: stroke 0.3s ease;
  }
  .cursor-shape {
    fill: black;
    stroke: black;
    transition:
      fill 0.3s ease,
      stroke 0.3s ease;
  }

  .cube-outline {
    stroke: #171925;
    stroke-width: 0.4;
    transition:
      stroke 0.3s ease,
      stroke-width 0.3s ease;
  }
  .cube-inner-line {
    stroke: #171925;
    stroke-width: 0.4;
    transition:
      stroke 0.3s ease,
      stroke-width 0.3s ease;
  }
  .cube-floor {
    fill: #f0f1f3;
    stroke: #aab1ba;
    transition:
      fill 0.3s ease,
      stroke 0.3s ease;
  }

  .bento-card-dark-dot {
    fill: #171925;
    transition: fill 0.3s ease;
  }

  .group:hover .custom-line-1-2 {
    stroke: rgba(255, 255, 255, 0.25);
  }
  .group:hover .custom-line-3 {
    stroke: rgba(255, 255, 255, 0.45);
  }

  .group:hover .cursor-stroke {
    stroke: white;
  }
  .group:hover .cursor-shape {
    fill: white;
    stroke: white;
  }

  .group:hover .cube-outline {
    stroke: #4eaef9;
    stroke-width: 1.5;
  }
  .group:hover .cube-inner-line {
    stroke: #4eaef9;
    stroke-width: 1.2;
  }
  .group:hover .cube-floor {
    fill: #0c0d14;
    stroke: #1f2233;
  }

  .group:hover .bento-card-dark-dot {
    fill: #ffffff;
  }

  /* Card 4 - Cloud & Enterprise orbit tracks and core animations */
  @keyframes rotate-clockwise {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes rotate-anticlockwise {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(-360deg);
    }
  }

  .anim-small-circle {
    transform-origin: 176px 296px;
  }

  .anim-inner-circle {
    transform-origin: 176px 296px;
    animation: rotate-clockwise 25s linear infinite;
  }

  .anim-outer-circle {
    transform-origin: 176px 296px;
    animation: rotate-anticlockwise 30s linear infinite;
  }

  /* Counter-rotate each icon so it stays upright while orbiting */
  .counter-rotate-outer {
    animation: rotate-clockwise 30s linear infinite;
  }

  .counter-rotate-inner {
    animation: rotate-anticlockwise 25s linear infinite;
  }

  .cloud-card-outer-track,
  .cloud-card-inner-track {
    transition:
      stroke-dashoffset 0.3s ease,
      stroke 0.3s ease;
    transform-box: fill-box;
    transform-origin: center;
  }
  .group:hover .cloud-card-outer-track {
    stroke: #4eaef9 !important;
    animation: orbit-spin-clockwise 15s linear infinite;
  }
  .group:hover .cloud-card-inner-track {
    stroke: #4eaef9 !important;
    animation: orbit-spin-anticlockwise 10s linear infinite;
  }
  @keyframes orbit-spin-clockwise {
    to {
      stroke-dashoffset: -100;
    }
  }
  @keyframes orbit-spin-anticlockwise {
    to {
      stroke-dashoffset: 100;
    }
  }

  .cloud-central-core {
    transition:
      transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      stroke 0.3s ease;
    transform-box: fill-box;
    transform-origin: center;
  }
  .group:hover .cloud-central-core {
    animation: central-cloud-breath 2s ease-in-out infinite alternate;
  }
  @keyframes central-cloud-breath {
    0% {
      transform: scale(1);
    }
    100% {
      transform: scale(1.08);
    }
  }

  .cloud-card-outer-circle {
    fill: url(#paint0_linear_179_191);
    transition: fill 0.3s ease;
  }
  .cloud-card-inner-circle {
    fill: #edf7fe;
    transition: fill 0.3s ease;
  }
  .cloud-card-icon-bg {
    fill: #e2e8f0;
    transition: fill 0.3s ease;
  }

  .group:hover .cloud-card-outer-circle {
    fill: #0c0d14;
  }
  .group:hover .cloud-card-inner-circle {
    fill: #ffffff;
  }
  .group:hover .cloud-card-icon-bg {
    fill: #ffffff;
  }

  /* Card 5 - Quality & Support styles and Globe grid rotation */
  .quality-badge-pill {
    fill: #171925;
    stroke: transparent;
    stroke-width: 1;
    transition: stroke 0.3s ease;
  }
  .group:hover .quality-badge-pill {
    stroke: #4eaef9;
  }
  .quality-badge-group {
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    transform-box: fill-box;
    transform-origin: center;
  }
  .group:hover .quality-badge-group {
    animation: badge-float 2.5s ease-in-out infinite alternate;
  }
  @keyframes badge-float {
    0% {
      transform: translateY(0);
    }
    100% {
      transform: translateY(-5px);
    }
  }

  .globe-sphere {
    fill: url(#paint0_linear_179_270);
    transition: fill 0.3s ease;
  }
  .group:hover .globe-sphere-hover {
    opacity: 1 !important;
  }
  .globe-grid-group path {
    transition:
      stroke 0.3s ease,
      stroke-dashoffset 0.3s ease;
    stroke-dasharray: 6 6;
  }
  .group:hover .globe-grid-group path {
    stroke: rgba(78, 174, 249, 0.35) !important;
    animation: globe-lines-flow 4s linear infinite;
  }
  @keyframes globe-lines-flow {
    to {
      stroke-dashoffset: -20;
    }
  }

  .side-dot-gray,
  .side-dot-dark {
    transition: fill 0.3s ease;
  }
  .group:hover .side-dot-gray {
    fill: #ffffff;
  }
  .group:hover .side-dot-dark {
    fill: #ffffff;
  }
  .badge-connector-line {
    transition: stroke 0.3s ease;
  }
  .group:hover .badge-connector-line {
    stroke: #4eaef9 !important;
  }

  /* Card 2 - Product Design styles and 3D Parallax */
  .design-floor {
    fill: #f0f1f3;
    stroke: #aab1ba;
    transition:
      fill 0.3s ease,
      stroke 0.3s ease;
  }
  .group:hover .design-floor {
    fill: #0c0d14;
    stroke: #1f2233;
  }
  .design-window-outline {
    stroke: #94959b;
    transition: stroke 0.3s ease;
  }
  .group:hover .design-window-outline {
    stroke: rgba(255, 255, 255, 0.4) !important;
  }
  .design-window-bg-1,
  .design-window-2,
  .design-window-3 {
    transition:
      transform 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      fill 0.3s ease,
      stroke 0.3s ease;
    transform-box: fill-box;
