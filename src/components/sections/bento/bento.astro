<script>
  const setupBentoAnimations = () => {
    const card = document.getElementById("product-design-card");
    const counter = document.getElementById("design-stat-counter");
    if (!card || !counter || card.dataset.animated) return;
    card.dataset.animated = "true";

    let intervalId: any = null;

    card.addEventListener("mouseenter", () => {
      let count = 0;
      counter.textContent = "0% +";
      if (intervalId) clearInterval(intervalId);
      intervalId = setInterval(() => {
        count += 1;
        if (count >= 90) {
          count = 90;
          clearInterval(intervalId);
        }
        counter.textContent = count + "% +";
      }, 15);
    });

    card.addEventListener("mouseleave", () => {
      if (intervalId) clearInterval(intervalId);
      counter.textContent = "90% +";
    });
  };

  setupBentoAnimations();
  document.addEventListener("astro:page-load", setupBentoAnimations);
</script>
