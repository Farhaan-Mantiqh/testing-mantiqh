---
import { Textr } from "../../ui/Textr";
import { bentoStats, bentoHeader, bentoCTA } from "../../../data/bento";
import { TextType } from "../../ui/TextType";
---

<section class="w-full bg-[#F8FAFC] text-[#0F172A]">
  <div class="max-w-[1440px] mx-auto w-full border-x border-slate-200 relative">
    <!-- Stats Row -->
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 border-b border-slate-200"
    >
      {
        bentoStats.map((stat, index) => (
          <div
            class:list={[
              "px-8 py-10 flex flex-col gap-3",
              index !== bentoStats.length - 1
                ? "lg:border-r border-slate-200"
                : "",
              index % 2 === 0
                ? "md:border-r border-slate-200 lg:border-r"
                : "",
              index === 1 ? "lg:border-r border-slate-200" : "",
              index === 3 ? "border-r-0" : "",
              index < 3 ? "border-b border-slate-200 lg:border-b-0" : "",
              index < 2
                ? "md:border-b border-slate-200 lg:border-b-0"
                : "md:border-b-0",
            ]}
          >
            <div class="flex items-center gap-3">
              <div class:list={["w-3 h-3 ", stat.color]} />
              <span class="text-body-m font-bold leading-[150%] ">
                {stat.number}
              </span>
            </div>
            <p class="text-body-s font-normal leading-[160%] text-[#454751] pl-6">
              {stat.description}
            </p>
          </div>
        ))
      }
    </div>

    <!-- Header Section -->
    <div class="px-6 lg:px-[3.20%] py-10">
      <div class="max-w-[800px]">
        <h2 class="text-h2 font-medium leading-[120%] mb-6 text-ink-500">
          {bentoHeader.title}
        </h2>
        <p
          class="text-body-m text-[#454751] font-normal leading-[150%] max-w-[600px]"
        >
          {bentoHeader.description}
        </p>
      </div>
    </div>

    <!-- Bento Grid Section -->
    <div class="px-6 lg:px-[3.20%] pb-16">
      <div class="grid grid-cols-1 md:grid-cols-6 lg:grid-cols-3 gap-6">
        <!-- Card 1: Data, AI & Analytics (Larger Card) -->
        <a
          
          class="md:col-span-6 lg:col-span-2 bg-white hover:bg-[#171925] border border-[#E2E8F0] hover:border-[#171925] rounded-md flex flex-col overflow-hidden relative group transition-all duration-500 ease-in-out block"
        >
          <div class="max-w-md px-6 pt-6 pb-2 md:px-8 md:pt-8 md:pb-2">
            <div class="flex items-center gap-3 mb-4">
              <div
                class="w-10 h-10 rounded-[8px] bg-[#4EAEF9] flex items-center justify-center text-white transition-all duration-500 ease-in-out group-hover:bg-[#4EAEF9]"
              >
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><path
                    d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"
                  ></path></svg
                >
              </div>
              <h3
                class="text-lg md:text-xl font-semibold text-[#0F172A] group-hover:text-white transition-colors duration-500 ease-in-out"
              >
                Data, AI & Analytics
              </h3>
            </div>
            <p
              class="text-sm md:text-base text-[#454751] group-hover:text-slate-100 leading-relaxed transition-colors duration-500 ease-in-out"
