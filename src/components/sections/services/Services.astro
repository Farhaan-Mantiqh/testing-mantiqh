---
import { servicesData } from "../../../data/services";
---

<section class="w-full bg-white border-y border-slate-200">
    <div class="max-w-[1440px] mx-auto flex flex-col md:flex-row min-h-[600px]">
        
        <!-- Left Column: Heading -->
        <div class="w-full md:w-[40%] p-8 md:p-24 flex items-center border-b md:border-b-0 md:border-r border-slate-200">
            <h2 class="text-[40px] md:text-[64px] font-bold text-[#0F172A] leading-[1.1] tracking-tight">
                Lead In The AI<br />Era With Mantiqh
            </h2>
        </div>

        <!-- Right Column: Services Grid -->
        <div class="w-full md:w-[60%] grid grid-cols-1 md:grid-cols-2">
            {servicesData.map((service, i) => (
                <div class:list={[
                    "p-8 md:p-12 flex flex-col gap-6 group hover:bg-slate-50 transition-colors duration-500",
                    i % 2 === 0 ? "md:border-r border-slate-200" : "",
                    i < 2 ? "border-b border-slate-200" : "border-b md:border-b-0 border-slate-200"
                ]}>
                    <div class="w-12 h-12 flex items-center justify-center text-slate-400 group-hover:text-[#0F172A] transition-colors">
                        {service.icon === 'agent' && (
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="10" x="3" y="11" rx="2"/><circle cx="12" cy="5" r="2"/><path d="M12 7v4"/><line x1="8" x2="8" y1="16" y2="16"/><line x1="16" x2="16" y1="16" y2="16"/></svg>
                        )}
                        {service.icon === 'automation' && (
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 10v4h4"/><path d="M15 10v4h4"/><rect width="18" height="18" x="3" y="3" rx="2"/></svg>
                        )}
                        {service.icon === 'analytics' && (
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
                        )}
                        {service.icon === 'consulting' && (
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                        )}
                    </div>
                    
                    <div class="flex flex-col gap-4">
                        <h3 class="text-[20px] md:text-[24px] font-bold text-[#0F172A]">{service.title}</h3>
                        <p class="text-slate-500 text-body-s md:text-body-m leading-relaxed max-w-[320px]">
                            {service.desc}
                        </p>
                        <a href="#" aria-label={`Read more about ${service.title}`} class="inline-flex items-center gap-2 text-blue-600 font-bold text-body-s hover:gap-3 transition-all duration-300">
                            Read More
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                        </a>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>
