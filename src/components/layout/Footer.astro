---
import Logo from "./Logo.astro";
---

<footer
  class="border-t border-muted-slate-800 bg-midnight-500 text-white relative overflow-hidden flex flex-col"
>
  <div
    class="grid grid-cols-1 lg:grid-cols-12 max-w-[1440px] mx-auto w-full lg:border-x border-muted-slate-800 flex-grow"
  >
    <!-- Left Column (8 columns wide) -->
    <div
      class="lg:col-span-8 flex flex-col border-b lg:border-b-0 lg:border-r border-muted-slate-800"
    >
      <!-- Top Left Section -->
      <div
        class="grid grid-cols-1 md:grid-cols-3 gap-8 px-6 py-8 md:p-12 lg:p-16 border-b border-muted-slate-800"
      >
        <!-- Solutions -->
        <nav class="flex flex-col space-y-3" aria-label="Footer Solutions">
          <h4 class="text-white font-medium mb-2 md:mb-4">Solutions</h4>
          <a
            href="/solutions/ai-ml-technologies"
            class="text-sm text-[#E8E8E9]"
            >AI/ML Technologies</a
          >
          <a
            href="/solutions/enterprise-content-management"
            class="text-sm text-[#E8E8E9]"
            >Enterprise Content Management</a
          >
          <a
            href="/solutions/product-development"
            class="text-sm text-[#E8E8E9]"
            >Product Development</a
          >
          <a
            href="/solutions/product-designing"
            class="text-sm text-[#E8E8E9]"
            >Product Designing</a
          >
          <a
            href="/solutions/data-analytics"
            class="text-sm text-[#E8E8E9]"
            >Data & Analytics Solutions</a
          >
          <a
            href="/solutions/cloud-solutions"
            class="text-sm text-[#E8E8E9]"
            >Cloud Solutions</a
          >
          <a
            href="/solutions/managed-support"
            class="text-sm text-[#E8E8E9]"
            >Managed Support Services</a
          >
          <a
            href="/solutions/testing-quality-assurance"
            class="text-sm text-[#E8E8E9]"
            >Testing & Quality Assurance</a
          >
        </nav>

        <!-- Quick Links -->
        <nav class="flex flex-col space-y-4" aria-label="Footer Quick Links">
          <h4 class="text-white font-medium mb-2 md:mb-4">Quick Links</h4>
          <a
            href="/work"
            class="text-sm text-[#E8E8E9]"
            >Work</a
          >
          <!-- 
          <a
            href="/blogs"
            class="text-sm text-[#E8E8E9]"
            >Blogs</a
          >
          -->
          <a
            href="/about-us"
            class="text-sm text-[#E8E8E9]"
            >About Us</a
          >
          <a
            href="/company"
            class="text-sm text-[#E8E8E9]"
            >Careers</a
          >
          <a
            href="/get-in-touch"
            class="text-sm text-[#E8E8E9]"
            >Contact Us</a
          >
        </nav>

        <!-- Addresses -->
        <div class="flex flex-col space-y-6">
          <h4 class="text-white font-medium mb-2 md:mb-4">Addresses</h4>
          <p class="text-sm leading-relaxed text-[#E8E8E9]">
            Mantiqh Technologies, #53, 4th Floor,<br />
            9th Main, 4th Cross, BTM Layout 1st<br />
            Stage, Bengaluru - 560029,<br />
            Karnataka, India.
          </p>
          <p class="text-sm leading-relaxed text-[#E8E8E9]">
            Mantiqh Technologies, 16 Egan Close<br />
            Weldon, Corby England, NN17 3NB
          </p>
        </div>
      </div>

      <!-- Bottom Left Section -->
      <div
        class="px-6 py-8 md:p-12 lg:p-16 grow flex flex-col md:flex-row gap-12 lg:gap-20 items-start relative overflow-hidden"
      >
        <!-- Background Watermark -->
        <div
          class="absolute inset-0 pointer-events-none z-0 flex items-center justify-center overflow-hidden"
        >
          <svg
            class="w-full h-full"
            preserveAspectRatio="xMidYMin slice"
            viewBox="0 0 780 301"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <g opacity="0.06">
              <g
                clip-path="url(#paint0_diamond_687_1048_clip_path)"
                data-figma-skip-parse="true"
              >
                <g
                  transform="matrix(-0.195571 0.0572268 -0.0743647 -0.21672 195.571 150.5)"
                >
                  <rect
                    x="0"
                    y="0"
                    width="1152.83"
                    height="874.614"
                    fill="url(#paint0_diamond_687_1048)"
                    opacity="1"
                    shape-rendering="crispEdges"></rect>
                  <rect
                    x="0"
                    y="0"
                    width="1152.83"
                    height="874.614"
                    transform="scale(1 -1)"
                    fill="url(#paint0_diamond_687_1048)"
                    opacity="1"
                    shape-rendering="crispEdges"></rect>
                  <rect
                    x="0"
                    y="0"
                    width="1152.83"
                    height="874.614"
                    transform="scale(-1 1)"
                    fill="url(#paint0_diamond_687_1048)"
                    opacity="1"
                    shape-rendering="crispEdges"></rect>
                  <rect
                    x="0"
                    y="0"
                    width="1152.83"
                    height="874.614"
                    transform="scale(-1)"
                    fill="url(#paint0_diamond_687_1048)"
                    opacity="1"
                    shape-rendering="crispEdges"></rect>
                </g>
              </g>
              <path
                d="M0 0L67.0528 20.5256L391.141 113.99V196.092L67.0528 97.4964V301L0 287.358V0Z"
                fill="url(#paint0_diamond_687_1048)"></path>
              <g
                clip-path="url(#paint1_diamond_687_1048_clip_path)"
                data-figma-skip-parse="true"
              >
                <g
                  transform="matrix(0.175312 0.111555 0.143987 -0.195588 585.395 150.5)"
                >
                  <rect
                    x="0"
                    y="0"
                    width="1189.39"
                    height="958.135"
                    fill="url(#paint1_diamond_687_1048)"
                    opacity="1"
                    shape-rendering="crispEdges"></rect>
                  <rect
                    x="0"
                    y="0"
                    width="1189.39"
                    height="958.135"
                    transform="scale(1 -1)"
                    fill="url(#paint1_diamond_687_1048)"
                    opacity="1"
                    shape-rendering="crispEdges"></rect>
                  <rect
                    x="0"
                    y="0"
                    width="1189.39"
                    height="958.135"
                    transform="scale(-1 1)"
                    fill="url(#paint1_diamond_687_1048)"
                    opacity="1"
                    shape-rendering="crispEdges"></rect>
                  <rect
                    x="0"
                    y="0"
                    width="1189.39"
                    height="958.135"
                    transform="scale(-1)"
                    fill="url(#paint1_diamond_687_1048)"
                    opacity="1"
                    shape-rendering="crispEdges"></rect>
                </g>
              </g>
              <path
                d="M779.648 0L713.047 20.5256L391.141 113.99V196.092L713.047 97.4964V301L779.648 287.358V0Z"
                fill="url(#paint1_diamond_687_1048)"></path>
            </g>
            <defs>
              <clipPath id="paint0_diamond_687_1048_clip_path"
                ><path
                  d="M0 0L67.0528 20.5256L391.141 113.99V196.092L67.0528 97.4964V301L0 287.358V0Z"
                ></path></clipPath
              >
              <clipPath id="paint1_diamond_687_1048_clip_path"
                ><path
                  d="M779.648 0L713.047 20.5256L391.141 113.99V196.092L713.047 97.4964V301L779.648 287.358V0Z"
                ></path></clipPath
              >
              <linearGradient
                id="paint0_diamond_687_1048"
                x1="0"
                y1="0"
                x2="500"
                y2="500"
                gradientUnits="userSpaceOnUse"
              >
                <stop stop-color="#387EC1"></stop>
                <stop offset="1" stop-color="#71BEFA"></stop>
              </linearGradient>
              <linearGradient
                id="paint1_diamond_687_1048"
                x1="0"
                y1="0"
                x2="500"
                y2="500"
                gradientUnits="userSpaceOnUse"
              >
                <stop stop-color="#4EAEF9"></stop>
                <stop offset="1" stop-color="#479EE3"></stop>
              </linearGradient>
            </defs>
          </svg>
        </div>

        <div class="max-w-[440px]   flex flex-col">
          <div class="mb-6 w-24 h-8 text-white">
            <Logo />
          </div>
          <p class="text-sm leading-relaxed text-[#E8E8E9]">
            We are the first call for every outrageous, unthinkable and unknown
            possibility in the field of digitally immersive experiences.
          </p>
        </div>

        <div
          class="flex flex-col sm:flex-row gap-8 sm:gap-12 lg:gap-16 mt-8 md:mt-0 w-full md:w-auto z-10 relative"
        >
          <!-- Social -->
          <div class="flex flex-col space-y-3">
            <h4 class="text-white font-medium text-sm">Social</h4>
            <div class="flex items-center space-x-4">
              <a
                href="https://www.linkedin.com/company/mantiqh-technologies/"
                aria-label="LinkedIn"
                class="text-white hover:text-[#479EE3] transition-colors"
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path
                    d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
                  ></path>
                  <rect width="4" height="12" x="2" y="9"></rect>
                  <circle cx="4" cy="4" r="2"></circle>
                </svg>
              </a>
            </div>
          </div>

          <!-- Reach to Us -->
          <div class="flex flex-col space-y-3">
            <h4 class="text-white font-medium text-sm">Reach to Us</h4>
            <a
              href="mailto:hello@mantiqh.com"
              class="text-sm text-[#E8E8E9] hover:text-[#479EE3] transition-colors"
              >hello@mantiqh.com</a
            >
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column (4 columns wide) -->
    <div class="lg:col-span-4 flex flex-col bg-midnight-500 relative">
      <!-- Top Right Section -->
      <div class="px-4 pt-16 pb-4 flex flex-col justify-start">
        <h2
          class="text-3xl lg:text-4xl font-medium text-white mb-4 leading-tight tracking-tight"
        >
          Let's Make Something<br />Together
        </h2>
        <p class="text-sm text-[#E8E8E9] mb-12 max-w-[280px] leading-relaxed">
          Partner with us to design, build, and scale<br /> digital solutions that
          drive measurable business outcomes
        </p>
      </div>

      <!-- Let's get started button block -->
      <a
        href="/get-in-touch"
        class="w-full bg-[#4083C5] hover:bg-[#3270AD] text-white px-6 py-8 md:px-12 lg:px-16 md:py-6 transition-colors group flex items-center justify-between"
      >
        <span class="text-xl font-medium">Let's Get Started</span>
        <svg
          class="transform group-hover:translate-x-2 transition-transform duration-300"
          width="40"
          height="12"
          viewBox="0 0 40 12"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M0 6H38M38 6L33 1M38 6L33 11"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>

      <!-- Bottom Right Section (Copyright & Links) -->
      <div class="px-6 py-8 md:p-12 lg:p-16 mt-auto flex flex-col space-y-4">
        <p class="text-sm text-[#E8E8E9]">
          © 2021 - 2026. Mantiqh All Rights Reserved.
        </p>
        <div class="flex space-x-6 text-sm">
          <a
            href="/privacy-policy"
            class="text-white underline underline-offset-4 decoration-slate-600 hover:decoration-slate-400 transition-colors"
            >Privacy Policy</a
          >
          <a
            href="/terms-and-conditions"
            class="text-white underline underline-offset-4 decoration-slate-600 hover:decoration-slate-400 transition-colors"
            >Terms & Conditions</a
          >
        </div>
      </div>
    </div>
  </div>
</footer>
