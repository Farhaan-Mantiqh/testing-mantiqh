---
interface Props {
  title: string;
  description: string;
  theme: "light" | "dark";
  icon: "hexagon" | "layers" | "cpu";
}

const { title, description, theme, icon } = Astro.props;

const isLight = theme === "light";
---

<div
  class={`ecosystem-card flex flex-row items-start gap-4 sm:gap-6 p-4 sm:p-6 rounded-lg border ${isLight ? "bg-white border-white" : "bg-midnight-500 border-slate-700/60 group-hover:bg-white group-hover:border-white"} transition-all duration-500 ease-out w-full relative z-10 group`}
>
  <!-- Inlined SVG Icons -->
  <div
    class="flex-shrink-0 relative flex items-center justify-center w-16 h-16 sm:w-24 sm:h-24 cursor-pointer transition-colors duration-500 border border-transparent overflow-hidden"
  >
    {
      icon === "hexagon" && (
        <svg
          class="w-full h-full"
          viewBox="0 0 105 105"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <rect
            width="105"
            height="105"
            rx="12"
            class="fill-[#71BEFA] group-hover:fill-white transition-colors duration-500"
          />
          <path
            d="M50.6504 9.41406C51.7949 8.7535 53.2051 8.7535 54.3496 9.41406L88.8877 29.3555C90.0325 30.0164 90.7383 31.2377 90.7383 32.5596V72.4404C90.7383 73.7623 90.0325 74.9836 88.8877 75.6445L54.3496 95.5859C53.2051 96.2465 51.7949 96.2465 50.6504 95.5859L16.1123 75.6445C14.9675 74.9836 14.2617 73.7623 14.2617 72.4404V32.5596C14.2617 31.2377 14.9675 30.0164 16.1123 29.3555L50.6504 9.41406Z"
            stroke-width="0.6"
            class="stroke-[#10121A] group-hover:stroke-slate-300 transition-colors duration-500"
          />
          <path
            d="M50.6504 17.4141C51.7949 16.7535 53.2051 16.7535 54.3496 17.4141L81.96 33.3555C83.1046 34.0164 83.8096 35.2378 83.8096 36.5596V68.4404C83.8096 69.7622 83.1046 70.9836 81.96 71.6445L54.3496 87.5859C53.2051 88.2465 51.7949 88.2465 50.6504 87.5859L23.04 71.6445C21.8954 70.9836 21.1904 69.7622 21.1904 68.4404V36.5596C21.1904 35.2378 21.8954 34.0164 23.04 33.3555L50.6504 17.4141Z"
            stroke-width="0.6"
            class="stroke-[#10121A] group-hover:stroke-slate-300 transition-colors duration-500"
          />
          <path
            d="M50.6504 25.4141C51.7949 24.7535 53.2051 24.7535 54.3496 25.4141L75.0312 37.3555C76.176 38.0164 76.8818 39.2377 76.8818 40.5596V64.4404C76.8818 65.7623 76.176 66.9836 75.0312 67.6445L54.3496 79.5859C53.2051 80.2465 51.7949 80.2465 50.6504 79.5859L29.9688 67.6445C28.824 66.9836 28.1182 65.7623 28.1182 64.4404V40.5596C28.1182 39.2377 28.824 38.0164 29.9688 37.3555L50.6504 25.4141Z"
            stroke-width="0.6"
            class="stroke-[#10121A] group-hover:stroke-slate-300 transition-colors duration-500"
          />
        </svg>
      )
    }
    {
      icon === "layers" && (
        <svg
          class="w-full h-full"
          viewBox="0 0 105 105"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <rect
            width="105"
            height="105"
            rx="12"
            class="fill-[#AEDAFC] group-hover:fill-white transition-colors duration-500"
          />
          <path
            d="M50.6504 9.41406C51.7949 8.7535 53.2051 8.7535 54.3496 9.41406L88.8877 29.3555C90.0325 30.0164 90.7383 31.2377 90.7383 32.5596V72.4404C90.7383 73.7623 90.0325 74.9836 88.8877 75.6445L54.3496 95.5859C53.2051 96.2465 51.7949 96.2465 50.6504 95.5859L16.1123 75.6445C14.9675 74.9836 14.2617 73.7623 14.2617 72.4404V32.5596C14.2617 31.2377 14.9675 30.0164 16.1123 29.3555L50.6504 9.41406Z"
            stroke-width="0.6"
            class="stroke-[#475569] group-hover:stroke-slate-300 transition-colors duration-500"
          />
          <path
            d="M51.3398 9.49512C51.9931 8.88482 53.0069 8.88482 53.6602 9.49512L75.4766 29.876C75.8206 30.1974 76.0155 30.6474 76.0156 31.1182V73.8818C76.0155 74.3526 75.8206 74.8026 75.4766 75.124L53.6602 95.5049C53.0069 96.1152 51.9931 96.1152 51.3398 95.5049L29.5234 75.124C29.1794 74.8026 28.9845 74.3526 28.9844 73.8818V31.1182C28.9845 30.6474 29.1794 30.1974 29.5234 29.876L51.3398 9.49512Z"
            stroke-width="0.6"
            class="stroke-[#475569] group-hover:stroke-slate-300 transition-colors duration-500"
          />
          <path
            d="M50.9814 9.68848C51.6092 8.44011 53.3908 8.44011 54.0186 9.68848L63.71 28.9609C63.8291 29.1979 63.8916 29.4594 63.8916 29.7246V75.2754C63.8916 75.5406 63.8291 75.8021 63.71 76.0391L54.0186 95.3115C53.3908 96.5599 51.6092 96.5599 50.9814 95.3115L41.29 76.0391C41.1709 75.8021 41.1084 75.5406 41.1084 75.2754V29.7246C41.1084 29.4594 41.1709 29.1979 41.29 28.9609L50.9814 9.68848Z"
            stroke-width="0.6"
            class="stroke-[#475569] group-hover:stroke-slate-300 transition-colors duration-500"
          />
        </svg>
      )
    }
    {
      icon === "cpu" && (
        <svg
          class="w-full h-full"
          viewBox="0 0 105 105"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <rect
            width="105"
            height="105"
            rx="12"
            class="fill-[#EDF7FE] group-hover:fill-white transition-colors duration-500"
          />
          <g transform="rotate(-45 52.5 52.5)">
            <path
              d="M59.5117 39.1888L59.5117 21.9026L52.8226 16L47.0891 21.9026L47.0891 39.1888"
              stroke-width="1.5"
              stroke-linecap="round"
              class="stroke-[#4EAEF9] group-hover:stroke-slate-300 transition-colors duration-500"
            />
            <path
              d="M59.5117 66.2155L59.5117 83.5017L52.8226 89.4043L47.0891 83.5017L47.0891 66.2155"
              stroke-width="1.5"
              stroke-linecap="round"
              class="stroke-[#4EAEF9] group-hover:stroke-slate-300 transition-colors duration-500"
            />
            <path
              d="M46.9335 39.2738L34.7209 27.4802L26.5237 27.6233L27.2421 35.2248L39.4547 47.0184"
              stroke-width="1.5"
              stroke-linecap="round"
              class="stroke-[#4EAEF9] group-hover:stroke-slate-300 transition-colors duration-500"
            />
            <path
              d="M46.9335 66.1305L34.7209 77.9241L26.5237 77.781L27.2421 70.1795L39.4547 58.3859"
              stroke-width="1.5"
              stroke-linecap="round"
              class="stroke-[#4EAEF9] group-hover:stroke-slate-300 transition-colors duration-500"
            />
            <path
              d="M59.5116 38.9206L72.5171 28.0076L80.6844 28.7222L79.4375 36.255L66.432 47.168"
              stroke-width="1.5"
              stroke-linecap="round"
              class="stroke-[#4EAEF9] group-hover:stroke-slate-300 transition-colors duration-500"
            />
            <path
              d="M59.5116 66.4837L72.5171 77.3967L80.6844 76.6821L79.4375 69.1493L66.432 58.2363"
              stroke-width="1.5"
              stroke-linecap="round"
              class="stroke-[#4EAEF9] group-hover:stroke-slate-300 transition-colors duration-500"
            />
            <path
              d="M39.7653 47.3086L22.7948 47.3086L17 53.1058L22.7948 58.0748L39.7653 58.0748"
              stroke-width="1.5"
              stroke-linecap="round"
              class="stroke-[#4EAEF9] group-hover:stroke-slate-300 transition-colors duration-500"
            />
            <path
              d="M66.2347 58.0742L83.2052 58.0742L89 52.277L83.2052 47.308L66.2347 47.308"
              stroke-width="1.5"
              stroke-linecap="round"
              class="stroke-[#4EAEF9] group-hover:stroke-slate-300 transition-colors duration-500"
            />
          </g>
        </svg>
      )
    }
  </div>

  <!-- Text Content -->
  <div class="flex flex-col gap-2 mt-2 transition-colors duration-500 z-10">
    <h4
      class={`text-body-l font-semibold ${isLight ? "text-slate-900" : "text-white group-hover:text-slate-900"} transition-colors duration-500`}
    >
      {title}
    </h4>
    <p
      class={`text-body-m font-normal leading-[150%] ${isLight ? "text-slate-600" : "text-[#AAB1BA] group-hover:text-slate-600"} transition-colors duration-500`}
    >
      {description}
    </p>
  </div>
</div>
