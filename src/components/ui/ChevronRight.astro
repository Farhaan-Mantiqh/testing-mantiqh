---
interface Props {
  className?: string;
  width?: number;
  height?: number;
  strokeWidth?: number;
}

const { 
  className = "", 
  width = 14, 
  height = 14, 
  strokeWidth = 2.5 
} = Astro.props;
---

<svg
  width={width}
  height={height}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
>
  <path d="M9 18l6-6-6-6"></path>
</svg>
